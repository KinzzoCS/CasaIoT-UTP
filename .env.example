# ─────────────────────────────────────────────────────────────
#  CasaIoT — Variables de entorno
#  Copia este archivo a .env y rellena los valores
#  NUNCA comitees .env al repositorio
# ─────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────
POSTGRES_DB=casaiot
POSTGRES_USER=casaiot
# CAMBIA ESTO: usa una contraseña fuerte (mínimo 20 caracteres)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ──────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_DIFFERENT

# ── MQTT Backend ─────────────────────────────────────────────
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=CHANGE_ME_MQTT_BACKEND_PASSWORD

# ── URLs ─────────────────────────────────────────────────────
# Cambia a la IP de tu PC en la red local para acceso desde ESP32 y móvil
# Ejemplo: http://192.168.1.100:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ── WiFi para firmware ESP32 ─────────────────────────────────
# Estos valores se usan SOLO como fallback si no se configuran
# desde Configuración → Seguridad → Red en la UI
NEXT_PUBLIC_WIFI_SSID=TuSSID
NEXT_PUBLIC_MQTT_BROKER=192.168.1.100

# ── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=production
# error | warn | info | debug  (por defecto: info en producción)
LOG_LEVEL=info

# ── Seguridad ────────────────────────────────────────────────
# Registro público de usuarios en la pantalla de login.
# false = solo un admin crea cuentas (Ajustes → Seguridad). Recomendado.
ALLOW_REGISTRATION=false
# Intentos fallidos de login por IP+usuario cada 15 min
AUTH_RATE_LIMIT_MAX=10
# Peticiones a la API por IP cada 15 min
RATE_LIMIT_MAX=2000
# Token para que Prometheus lea /metrics desde fuera de localhost (vacío = solo localhost)
METRICS_TOKEN=
# Segundos sin mensajes para marcar un dispositivo como offline
# (el firmware manda telemetría cada 60 s)
DEVICE_OFFLINE_SECONDS=150

# ── Usuario Admin Inicial ────────────────────────────────────
# Lo usa scripts/create-admin.js. CAMBIA la contraseña.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
